# Environment Configuration
# Copy this file to .env and fill in your values

# MongoDB Atlas (transactions require a replica set or sharded cluster)
MONGODB_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=baangs_fsm

# JWT Secret (set a unique random value of at least 32 characters in production)
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# App Settings
APP_NAME=Baangs FSM
ENVIRONMENT=development
ALLOW_MOCK_DATABASE=false
# Set only for an explicitly isolated demo using the mock database.
# MOCK_SEED_PASSWORD=
FRONTEND_URL=http://localhost:5173
MOBILE_APP=true
